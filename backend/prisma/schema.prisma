generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model checkin {
  id_checkin    Int       @id @default(autoincrement())
  id_reservasi  Int       @unique(map: "id_reservasi")
  waktu_checkin DateTime  @default(now()) @db.DateTime(0)
  id_pegawai    Int
  catatan       String?   @db.Text
  pegawai       pegawai   @relation(fields: [id_pegawai], references: [id_pegawai], map: "fk_checkin_pegawai")
  reservasi     reservasi @relation(fields: [id_reservasi], references: [id_reservasi], onDelete: Cascade, map: "fk_checkin_reservasi")

  @@index([id_pegawai], map: "fk_checkin_pegawai")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model checkout {
  id_checkout    Int       @id @default(autoincrement())
  id_reservasi   Int       @unique(map: "id_reservasi")
  waktu_checkout DateTime  @default(now()) @db.DateTime(0)
  id_pegawai     Int
  biaya_tambahan Decimal   @default(0.00) @db.Decimal(12, 2)
  catatan        String?   @db.Text
  pegawai        pegawai   @relation(fields: [id_pegawai], references: [id_pegawai], map: "fk_checkout_pegawai")
  reservasi      reservasi @relation(fields: [id_reservasi], references: [id_reservasi], onDelete: Cascade, map: "fk_checkout_reservasi")

  @@index([id_pegawai], map: "fk_checkout_pegawai")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detail_reservasi {
  id_detail_reservasi Int       @id @default(autoincrement())
  id_reservasi        Int
  id_kamar            Int
  jumlah_malam        Int
  harga_per_malam     Decimal   @db.Decimal(12, 2)
  subtotal            Decimal?  @db.Decimal(12, 2)
  kamar               kamar     @relation(fields: [id_kamar], references: [id_kamar], map: "fk_detail_kamar")
  reservasi           reservasi @relation(fields: [id_reservasi], references: [id_reservasi], onDelete: Cascade, map: "fk_detail_reservasi")

  @@unique([id_reservasi, id_kamar], map: "uk_reservasi_kamar")
  @@index([id_kamar], map: "idx_detail_kamar")
}

model fasilitas {
  id_fasilitas    Int               @id @default(autoincrement())
  nama_fasilitas  String            @unique(map: "nama_fasilitas") @db.VarChar(80)
  deskripsi       String?           @db.Text
  kamar_fasilitas kamar_fasilitas[]
}

model kamar {
  id_kamar           Int                  @id @default(autoincrement())
  id_tipe_kamar      Int
  nomor_kamar        String               @unique(map: "nomor_kamar") @db.VarChar(10)
  lantai             String               @db.VarChar(10)
  status_kamar       kamar_status_kamar   @default(Tersedia)
  detail_reservasi   detail_reservasi[]
  tipe_kamar         tipe_kamar           @relation(fields: [id_tipe_kamar], references: [id_tipe_kamar], map: "fk_kamar_tipe")
  kamar_fasilitas    kamar_fasilitas[]
  tugas_housekeeping tugas_housekeeping[]

  @@index([status_kamar], map: "idx_kamar_status")
  @@index([id_tipe_kamar], map: "idx_kamar_tipe")
}

model kamar_fasilitas {
  id_kamar     Int
  id_fasilitas Int
  fasilitas    fasilitas @relation(fields: [id_fasilitas], references: [id_fasilitas], onDelete: Cascade, map: "fk_kf_fasilitas")
  kamar        kamar     @relation(fields: [id_kamar], references: [id_kamar], onDelete: Cascade, map: "fk_kf_kamar")

  @@id([id_kamar, id_fasilitas])
  @@index([id_fasilitas], map: "fk_kf_fasilitas")
}

model log_aktivitas {
  id_log          Int      @id @default(autoincrement())
  id_pegawai      Int?
  aktivitas       String   @db.VarChar(100)
  waktu_aktivitas DateTime @default(now()) @db.DateTime(0)
  keterangan      String?  @db.Text
  pegawai         pegawai? @relation(fields: [id_pegawai], references: [id_pegawai], map: "fk_log_pegawai")

  @@index([id_pegawai], map: "idx_log_pegawai")
  @@index([waktu_aktivitas], map: "idx_log_waktu")
}

model pegawai {
  id_pegawai         Int                  @id @default(autoincrement())
  nama_pegawai       String               @db.VarChar(100)
  jabatan            String               @db.VarChar(50)
  no_telepon         String               @db.VarChar(20)
  email              String               @unique(map: "email") @db.VarChar(100)
  is_active          Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  password           String               @db.VarChar(255)
  checkin            checkin[]
  checkout           checkout[]
  log_aktivitas      log_aktivitas[]
  reservasi          reservasi[]
  tugas_housekeeping tugas_housekeeping[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pembayaran {
  id_pembayaran      Int                          @id @default(autoincrement())
  id_reservasi       Int
  tanggal_pembayaran DateTime                     @default(now()) @db.DateTime(0)
  jumlah_bayar       Decimal                      @db.Decimal(12, 2)
  metode_pembayaran  pembayaran_metode_pembayaran
  status_pembayaran  pembayaran_status_pembayaran @default(Pending)
  reservasi          reservasi                    @relation(fields: [id_reservasi], references: [id_reservasi], onDelete: Cascade, map: "fk_pembayaran_reservasi")

  @@index([id_reservasi], map: "idx_pembayaran_reservasi")
  @@index([status_pembayaran], map: "idx_pembayaran_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservasi {
  id_reservasi             Int                        @id @default(autoincrement())
  id_tamu                  Int
  id_pegawai               Int
  tanggal_reservasi        DateTime                   @default(now()) @db.DateTime(0)
  tanggal_checkin_rencana  DateTime                   @db.Date
  tanggal_checkout_rencana DateTime                   @db.Date
  status_reservasi         reservasi_status_reservasi @default(Menunggu)
  checkin                  checkin?
  checkout                 checkout?
  detail_reservasi         detail_reservasi[]
  pembayaran               pembayaran[]
  pesanan_restoran         pesanan_restoran[]
  detail_layanan_kamar     detail_layanan_kamar[]
  pegawai                  pegawai                    @relation(fields: [id_pegawai], references: [id_pegawai], map: "fk_reservasi_pegawai")
  tamu                     tamu                       @relation(fields: [id_tamu], references: [id_tamu], map: "fk_reservasi_tamu")

  @@index([status_reservasi], map: "idx_reservasi_status")
  @@index([id_pegawai], map: "idx_reservasi_pegawai")
  @@index([id_tamu], map: "idx_reservasi_tamu")
}

model tamu {
  id_tamu       Int                @id @default(autoincrement())
  nama_tamu     String             @db.VarChar(100)
  no_identitas  String             @unique(map: "no_identitas") @db.VarChar(30)
  jenis_kelamin tamu_jenis_kelamin
  no_telepon    String             @db.VarChar(20)
  email         String?            @unique(map: "email") @db.VarChar(100)
  alamat        String             @db.Text
  is_active     Boolean?           @default(true)
  created_at    DateTime?          @default(now()) @db.Timestamp(0)
  updated_at    DateTime?          @default(now()) @db.Timestamp(0)
  reservasi     reservasi[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tipe_kamar {
  id_tipe_kamar   Int     @id @default(autoincrement())
  nama_tipe       String  @unique(map: "nama_tipe") @db.VarChar(50)
  kapasitas       Int
  harga_per_malam Decimal @db.Decimal(12, 2)
  deskripsi       String? @db.Text
  kamar           kamar[]
}

model menu_restoran {
  id_menu          Int                    @id @default(autoincrement())
  nama_menu        String                 @unique(map: "nama_menu") @db.VarChar(100)
  harga            Decimal                @db.Decimal(12, 2)
  kategori         menu_restoran_kategori @default(MAKANAN)
  isTersedia       Boolean                @default(true)
  pesanan_restoran pesanan_restoran[]
}

model pesanan_restoran {
  id_pesanan    Int                           @id @default(autoincrement())
  id_reservasi  Int
  id_menu       Int
  jumlah        Int
  total_harga   Decimal                       @db.Decimal(12, 2)
  status_bayar  pesanan_restoran_status_bayar
  waktu_pesan   DateTime?                     @default(now()) @db.Timestamp(0)
  menu_restoran menu_restoran                 @relation(fields: [id_menu], references: [id_menu], map: "fk_pesanan_menu")
  reservasi     reservasi                     @relation(fields: [id_reservasi], references: [id_reservasi], onDelete: Cascade, map: "fk_pesanan_reservasi")

  @@index([id_menu], map: "fk_pesanan_menu")
  @@index([id_reservasi], map: "fk_pesanan_reservasi")
}

model tugas_housekeeping {
  id_tugas      Int                             @id @default(autoincrement())
  id_kamar      Int
  id_pegawai    Int?
  status_tugas  tugas_housekeeping_status_tugas @default(Pending)
  waktu_dibuat  DateTime                        @default(now()) @db.DateTime(0)
  waktu_mulai   DateTime?                       @db.DateTime(0)
  waktu_selesai DateTime?                       @db.DateTime(0)
  kamar         kamar                           @relation(fields: [id_kamar], references: [id_kamar], onDelete: Cascade, onUpdate: NoAction, map: "fk_tugas_kamar")
  pegawai       pegawai?                        @relation(fields: [id_pegawai], references: [id_pegawai], onUpdate: NoAction, map: "fk_tugas_pegawai")

  @@index([id_pegawai], map: "fk_tugas_pegawai")
  @@index([id_kamar], map: "idx_tugas_kamar")
  @@index([status_tugas], map: "idx_tugas_status")
}

model layanan_tambahan {
  id_layanan           Int                          @id @default(autoincrement())
  nama_layanan         String                       @unique @db.VarChar(100)
  harga                Decimal                      @db.Decimal(12, 2)
  tipe_charge          layanan_tambahan_tipe_charge @default(PER_SEKALI_AKSI)
  detail_layanan_kamar detail_layanan_kamar[]
}

model detail_layanan_kamar {
  id_detail_layanan Int       @id @default(autoincrement())
  id_reservasi      Int
  id_layanan        Int
  jumlah            Int
  total_harga       Decimal   @db.Decimal(12, 2)
  waktu_pesan       DateTime? @default(now()) @db.Timestamp(0)

  layanan_tambahan layanan_tambahan @relation(fields: [id_layanan], references: [id_layanan])
  reservasi        reservasi        @relation(fields: [id_reservasi], references: [id_reservasi], onDelete: Cascade)

  @@index([id_reservasi], map: "fk_detail_layanan_reservasi")
  @@index([id_layanan], map: "fk_detail_layanan_master")
}

enum tamu_jenis_kelamin {
  Laki_laki @map("Laki-laki")
  Perempuan
}

enum pembayaran_metode_pembayaran {
  Tunai
  Transfer
  Kartu_Kredit @map("Kartu Kredit")
  E_Wallet     @map("E-Wallet")
}

enum pembayaran_status_pembayaran {
  Pending
  Lunas
  Gagal
  Refund
}

enum reservasi_status_reservasi {
  Menunggu
  Dikonfirmasi
  Check_in     @map("Check-in")
  Selesai
  Dibatalkan
}

enum menu_restoran_kategori {
  MAKANAN
  MINUMAN
  DESSERT
}

enum pesanan_restoran_status_bayar {
  Lunas
  Charge_to_Room @map("Charge-to-Room")
}

enum tugas_housekeeping_status_tugas {
  Pending
  In_Progress
  Completed
}

enum kamar_status_kamar {
  Tersedia
  Dipesan
  Terisi
  Kotor
  Perawatan
}

enum layanan_tambahan_tipe_charge {
  PER_JAM
  PER_HARI
  PER_SEKALI_AKSI
}
